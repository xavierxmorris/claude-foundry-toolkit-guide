# Copy this file to ".env" and fill in YOUR OWN values.
# NEVER commit your real .env — it is git-ignored by design.
#
# These are PLACEHOLDERS. Replace every <...> with your own values.

# --- Azure subscription that contains your Foundry resource ---
AZURE_SUBSCRIPTION_ID=<SUBSCRIPTION_ID>

# --- Resource group + AI Services (Foundry) account name ---
FOUNDRY_RESOURCE_GROUP=<RESOURCE_GROUP>
FOUNDRY_ACCOUNT_NAME=<FOUNDRY_ACCOUNT_NAME>

# --- The REAL Claude model id from the catalog ---
# Run scaffold/list-claude-models.ps1 to discover valid names/versions.
CLAUDE_MODEL_NAME=claude-sonnet-4-5
CLAUDE_MODEL_VERSION=20250929
CLAUDE_DEPLOYMENT_NAME=claude-sonnet-4-5
CLAUDE_CAPACITY=1

# --- Required for Anthropic deployments (provider compliance form) ---
ANTHROPIC_INDUSTRY=Technology
ANTHROPIC_ORG_NAME=<YOUR_ORGANIZATION_NAME>
ANTHROPIC_COUNTRY_CODE=AU

# --- Region (used by quota checks) ---
FOUNDRY_REGION=<REGION>
